{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:best-practices",
		"github>ui5/renovate-config:lts#v1.2.1"
	],
	"ignorePresets": [":ignoreModulesAndTests", ":pinDevDependencies"],
	"ignoreDeps": ["node", "npm", "@types/qunit", "@openui5/types"],
	"customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "**/package.json"
      ],
      "matchStrings": [
        "\"@openui5/types\":\\s*\"(?<currentValue>[\\d.]+)\""
      ],
      "depNameTemplate": "openui5_types",
      "datasourceTemplate": "custom.openui5_lts"
    }
  ],
	"minimumReleaseAge": "3 days",
	"rangeStrategy": "replace",
	"prCreation": "immediate",
	"lockFileMaintenance": {
		"enabled": true,
		"automerge": true,
		"minimumReleaseAge": "3 days",
		"commitMessagePrefix": "build:",
		"commitMessageAction": "In-range update of npm dependencies",
		"schedule": [
			"* 0-8 * * 1"
		]
	},
	"packageRules": [
		{
			"description": "Auto-merge minor and patch updates",
			"matchDepNames": [
				"*"
			],
			"matchUpdateTypes": ["minor", "patch"],
			"automerge": true,
			"commitMessagePrefix": "build(deps-dev):",
			"commitMessageAction": "Bump",
			"schedule": [
				"* 8-16 * * 1"
			]
		},
		{
			"matchManagers": [
				"github-actions"
			],
			"automerge": true,
			"commitMessagePrefix": "build(github-actions):",
			"commitMessageAction": "Bump",
			"schedule": [
				"* 8-16 * * 1"
			]
		},
		{
			"matchDepNames": [
				"openui5_lts",
				"openui5_types"
			],
			"automerge": false,
			"groupName": "openui5",
			"commitMessagePrefix": "deps:",
			"commitMessageAction": "Update",
			"minimumReleaseAge": null,
			"schedule": [
				"* 8-16 * * 1"
			],
			"postUpgradeTasks": {
				"commands": ["npm install"],
				"fileFilters": ["package-lock.json"],
				"executionMode": "branch"
			}
		}
	]
}
